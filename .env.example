# Application Settings
APP_NAME="MT5 Web Service"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# MetaTrader 5 Terminal Configuration
# Static credentials for mt5.initialize() / mt5.login()
MT5_LOGIN=12345678
MT5_PASSWORD=YourTradingPassword
MT5_SERVER=YourBroker-Server
# Optional custom path to terminal64.exe (leave blank to use default terminal installation)
MT5_PATH=
MT5_PORTABLE=false
MT5_TIMEOUT=60000

# Connection Lifecycle & Reconnection Loop
MT5_HEARTBEAT_INTERVAL=5.0
MT5_RETRY_BASE_DELAY=2.0
MT5_RETRY_MAX_DELAY=30.0
MT5_RETRY_BACKOFF_FACTOR=1.5
